{
  "additionalProperties": false,
  "description": "Progress of one pipeline stage.",
  "properties": {
    "stage": {
      "description": "Which stage.",
      "enum": [
        "intake",
        "research",
        "simulate",
        "summary",
        "challenger",
        "script",
        "audio",
        "music",
        "images"
      ],
      "title": "Stage",
      "type": "string"
    },
    "status": {

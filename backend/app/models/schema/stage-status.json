        "running",
        "done",
        "failed",
        "fallback"
      ],
      "title": "Status",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Short user-facing note, e.g. which fighter is being researched.",
      "title": "Detail"
    }
  },
  "required": [
    "stage",
    "status"
  ],
  "title": "StageStatus",
  "type": "object"

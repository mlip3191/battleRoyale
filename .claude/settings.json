{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "Bash(npm run setup)",
      "Bash(npm run dev)",
      "Bash(npm start)",
      "Bash(npm run start)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run gen:api)",
      "Bash(npm run fixtures:sync)",
      "Bash(npm run env:check)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run --directory backend pytest:*)",
      "Bash(uv run --directory backend ruff:*)",
      "Bash(node scripts/check-env.mjs)",
      "Bash(node .claude/hooks/test-hooks.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git restore --staged:*)",
      "Bash(git push)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh label list:*)",
      "Bash(gh secret list:*)"
    ],
    "ask": [
      "Bash(gh api:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock:*)",
      "Bash(uv pip:*)",
      "Bash(pip install:*)",
      "Bash(brew install:*)",
      "Bash(winget install:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh label create:*)",
      "Bash(gh project:*)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./INIT.md)",
      "Write(./INIT.md)",
      "Edit(./.gitignore)",
      "Write(./.gitignore)",
      "Edit(./.gitattributes)",
      "Write(./.gitattributes)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(./backend/pyproject.toml)",
      "Write(./backend/pyproject.toml)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.test)",
      "Write(**/.env.*.local)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(Remove-Item -Recurse:*)",
      "Bash(sudo:*)",
      "Bash(printenv:*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ensure-hookspath.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\""
          }
        ]
      }
    ]
  }
}

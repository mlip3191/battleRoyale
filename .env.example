# =============================================================================
#  .env.example - TEMPLATE ONLY. Committed to git: never put real values here.
#
#  Easiest setup: in your own terminal window, run  npm run env:setup
#  It asks for the course host and API key (hidden) and writes .env for you.
#  (In Claude Code, type /setup-env for step-by-step help.)
#
#  Setup by hand (everyone, once per clone):
#    1. Copy this file to a new file named ".env" in the same folder (repo root).
#         Windows:  copy .env.example .env
#         Mac:      cp .env.example .env
#    2. Open .env in VS Code (or Notepad) and fill in every line marked [required]
#       with the course endpoint URLs, ports, and key(s) from the course materials.
#       Everyone on the team has these values; never paste them into GitHub,
#       issues, PRs, commits, or chats.
#    3. Check it without showing any values:   node scripts/check-env.mjs
#    4. .env is ignored by git, so your values stay on your machine.
#
#  Rules: every variable the app reads is listed here with a comment.
#  Only backend/app/config.py reads these. Add new ones in the same PR that uses them.
#  Lines marked [required] must be filled for live mode (PROVIDER_MODE=live).
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
# Backend port (FastAPI)
PORT=8000
# Where the front end runs, for CORS
FRONTEND_ORIGIN=http://localhost:5173
# Log level: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# --- Providers ---------------------------------------------------------------
# mock = no network, deterministic fakes (CI always uses this)
# live = call the course endpoints below. Set to live once the URLs are filled in.
PROVIDER_MODE=mock
# Seconds before a live call times out
PROVIDER_TIMEOUT_S=30

# --- Course endpoints -------------------------------------------------------
# Format: http(s)://<host>:<port>  - use the exact host, port, and scheme from the course list.
# Keys: one shared key goes in COURSE_API_KEY. If a service has its own key, add a line
# <SERVICE>_API_KEY=... (e.g. TTS_API_KEY) - it overrides COURSE_API_KEY for that service.

# [required] API key for the course endpoints
COURSE_API_KEY=replace-me

# [required] Chat / Classification LLM (course list: port 9001)
CHAT_LLM_URL=http://replace-me-host:9001
# [required] Model name the chat endpoint expects
CHAT_LLM_MODEL=replace-me
# [required] Structured Decisions: choice questions with probabilities, e.g. the
# next-challenger pick; it never extracts stats (DECISIONS D-41) (course list: port 9010)
STRUCTURED_LLM_URL=http://replace-me-host:9010
# [required] Model name the structured endpoint expects
STRUCTURED_LLM_MODEL=replace-me
# [required] Text Embeddings (course list: port 9002)
EMBEDDINGS_URL=http://replace-me-host:9002
# [required] Embedding model name
EMBEDDINGS_MODEL=replace-me
# [required] Multimodal Reranking (course list: port 9004)
RERANK_URL=http://replace-me-host:9004
# [required] Document Parsing (course list: port 9005)
DOC_PARSE_URL=http://replace-me-host:9005
# [required] Image Generation and Editing (course list: port 9006)
IMAGE_URL=http://replace-me-host:9006
# [required] Text-to-Speech and Voice Cloning (course list: port 9008)
TTS_URL=http://replace-me-host:9008
# [required] Music Generation (course list: port 9007)
MUSIC_URL=http://replace-me-host:9007
# Speech-to-Text (stretch goal; leave blank until used)
STT_URL=
# Multimodal Embeddings (stretch goal; leave blank until used)
MM_EMBEDDINGS_URL=
# Hermes Primary Model + Hermes Agent (course list: port 9000). Not used by the app;
# only for the Hermes Agent session in task G06 (DECISIONS D-02).
HERMES_URL=

# --- Announcer voice (DECISIONS D-09) ----------------------------------------
# stock = a built-in TTS voice (first iteration); cloned = a teammate's voice (needs consent)
ANNOUNCER_VOICE_SOURCE=stock
# Voice id chosen in task A07: the deepest, gruffest stock voice. A07 replaces this default.
ANNOUNCER_VOICE_ID=replace-me
# Delivery style sent to the TTS endpoint if it supports style or pitch settings
ANNOUNCER_VOICE_STYLE=gruff, deep, hard-hitting fight announcer
# Path to the signed consent note, only when ANNOUNCER_VOICE_SOURCE=cloned
ANNOUNCER_VOICE_CONSENT_FILE=

# --- Simulation ---------------------------------------------------------------
# Monte Carlo runs per battle
SIM_RUNS=1000
# Maximum fighters per side
SIM_MAX_COUNT=10000

# --- Storage -------------------------------------------------------------------
# All generated data lives under this folder (gitignored except seed/, benchmark/, showcase/)
DATA_DIR=./data

# --- Front end (Vite reads VITE_* variables) ----------------------------------
# Leave blank to use the dev proxy (same origin)
VITE_API_BASE=
# true = the UI uses local fixtures and needs no backend
VITE_USE_FIXTURES=false

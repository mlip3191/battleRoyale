# =============================================================================
#  .env.example - TEMPLATE ONLY. Committed to a PUBLIC repo: never put real values here.
#
#  Setup:
#    1. Copy this file to ".env" in the same folder.
#         Mac:      cp .env.example .env
#         Windows:  copy .env.example .env
#    2. Fill in the values Mike shares through the team password manager.
#       Course endpoint hosts count as private: keep them out of chat, issues, and code.
#    3. .env is ignored by git, so your values stay on your machine.
#
#  Rules: every variable the app reads is listed here with a comment.
#  Only backend/app/config.py reads these. Add new ones in the same PR that uses them.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
# Backend port (FastAPI)
PORT=8000
# Where the front end runs, for CORS
FRONTEND_ORIGIN=http://localhost:5173
# Log level: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# --- Providers ---------------------------------------------------------------
# mock = no network, deterministic fakes (default; CI always uses this)
# live = call the course endpoints below
PROVIDER_MODE=mock
# Only if the course endpoints require a key (DECISIONS D-03). Leave blank if not.
COURSE_API_KEY=
# Seconds before a live call times out
PROVIDER_TIMEOUT_S=30

# --- Course endpoints (DECISIONS D-03) ---------------------------------------
# Replace replace-me-host with the real host. If Docker runs the app and the
# endpoints are on your own machine, use host.docker.internal instead.
# Chat / Classification LLM (port 9001)
CHAT_LLM_URL=http://replace-me-host:9001
# Model name to request from the chat endpoint, if it needs one
CHAT_LLM_MODEL=replace-me
# Text Embeddings (port 9002)
EMBEDDINGS_URL=http://replace-me-host:9002
# Document Parsing (port 9005)
DOC_PARSE_URL=http://replace-me-host:9005
# Image Generation and Editing (port 9006)
IMAGE_URL=http://replace-me-host:9006
# Structured Decisions (port unknown - ask the instructor)
STRUCTURED_LLM_URL=
# Multimodal Reranking (port unknown)
RERANK_URL=
# Text-to-Speech and Voice Cloning (port unknown)
TTS_URL=
# Music Generation (port unknown)
MUSIC_URL=
# Speech-to-Text (stretch, port unknown)
STT_URL=
# Multimodal Embeddings (stretch, port unknown)
MM_EMBEDDINGS_URL=

# --- Announcer voice (DECISIONS D-09) ----------------------------------------
# stock = a built-in TTS voice; cloned = a teammate's voice (needs consent file)
ANNOUNCER_VOICE_SOURCE=stock
# Voice id from the TTS endpoint
ANNOUNCER_VOICE_ID=replace-me
# Path to the signed consent note, only when ANNOUNCER_VOICE_SOURCE=cloned
ANNOUNCER_VOICE_CONSENT_FILE=

# --- Simulation ---------------------------------------------------------------
# Monte Carlo runs per battle
SIM_RUNS=1000
# Maximum fighters per side
SIM_MAX_COUNT=10000

# --- Storage -------------------------------------------------------------------
# All generated data lives under this folder (gitignored except seed/ and benchmark/)
DATA_DIR=./data

# --- Front end (Vite reads VITE_* variables) ----------------------------------
# Leave blank to use the dev proxy (same origin)
VITE_API_BASE=
# true = the UI uses local fixtures and needs no backend
VITE_USE_FIXTURES=false

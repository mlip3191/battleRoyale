# Line endings: LF everywhere so the git hook and scripts work on Windows and Mac
* text=auto eol=lf
.githooks/* text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary files: never convert line endings or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
*.flac binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

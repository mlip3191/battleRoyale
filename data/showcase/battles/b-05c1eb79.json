  "scripts": [
    {
      "kind": "intro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Ladies and gentlemen, welcome to the simulation! Tonight, we settle the debate of mass versus pack.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Indeed. The algorithm has run 1000 iterations. The data is statistically significant.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the red corner, standing 2.4 meters tall, comes the Grizzly Bear! Weight: 389 kg!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "A solitary force. Legend says its aggression is high, but its teamwork score is low.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the blue corner, four Gray Wolves stand ready! Speed: 17.78 m/s each!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "They operate as a unit with a teamwork rating of 0.8. It is a classic numbers game.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "The computer has spoken! Who will dominate the ring? Find out right now! Fight!",
          "at_event": null
        }
      ],
      "fallback": false
    },
    {
      "kind": "play_by_play",
      "lines": [
        {
          "speaker": "announcer",
          "text": "They circle each other, tension thick in the air.",
          "at_event": 0
        },
        {
          "speaker": "color_commentator",
          "text": "The size difference is immediate and intimidating.",
          "at_event": 1
        },
        {
          "speaker": "announcer",
          "text": "First clash! Teeth meet fur in a spark of impact.",
          "at_event": 3
        },
        {
          "speaker": "announcer",
          "text": "The pack swarms with precision, finding open gaps.",
          "at_event": 8
        },
        {
          "speaker": "color_commentator",
          "text": "It’s like watching a well-oiled machine at work.",
          "at_event": 12
        },
        {
          "speaker": "announcer",
          "text": "Grizzly swings wildly, trying to keep them off!",
          "at_event": 15
        },
        {
          "speaker": "announcer",
          "text": "One wolf goes down but the others take its place instantly.",
          "at_event": 100
        },
        {
          "speaker": "color_commentator",
          "text": "That was just a temporary setback for the team.",
          "at_event": 101
        },
        {
          "speaker": "announcer",
          "text": "The bear breaks contact, sensing the overwhelming tide.",
          "at_event": 108
        },
        {
          "speaker": "announcer",
          "text": "He tries to stand his ground but the pressure mounts.",
          "at_event": 147
        },
        {
          "speaker": "announcer",
          "text": "Down he goes! The final strike seals his fate!",
          "at_event": 148
        },
        {
          "speaker": "color_commentator",
          "text": "And that is how you coordinate a victory.",
          "at_event": 149
        }
      ],
      "fallback": false
    },
    {
      "kind": "outro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "The simulation speaks, and here is the verdict.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Gray wolf wins 55% of the time.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "It came down to sheer mass.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Your winner: Gray wolf!",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Want a fair fight? It's already about even, winning 49% of the time.",
          "at_event": null
        }
      ],
      "fallback": false
    }
  ],

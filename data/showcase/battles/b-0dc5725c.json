        {
          "speaker": "color_commentator",
          "text": "We have a clash of civilizations tonight.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the red corner, the Roman legionary, 1.69 meters tall!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "His mass is estimated at 70 kilograms.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the blue corner, Gorilla, standing 1.67 meters high!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "He weighs in at a solid 140 kilograms.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Only one can walk away! Let us fight!",
          "at_event": null
        }
      ],
      "fallback": false
    },
    {
      "kind": "play_by_play",
      "lines": [

          "text": "Unrelenting bites, down goes the legionary.",
          "at_event": 60
        },
        {
          "speaker": "color_commentator",
          "text": "Game over. Gorilla takes it.",
          "at_event": 61
        }
      ],
      "fallback": false
    },

  "scripts": [
    {
      "kind": "intro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Welcome to Battle Royale! Tonight, steel meets muscle in a clash of epochs!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "A singular Roman legionary faces off against one solitary Gorilla.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the red corner, standing at 1.69 meters, the disciplined Legionary!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Estimated mass is seventy kilograms. He brings discipline and formation.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "And in the blue corner, towering at 1.67 meters, the mighty Gorilla!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "One hundred and forty kilograms of raw, natural power. The odds are clear.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Only one can stand when the simulation ends! Fight!",
          "at_event": null
        }
      ],
      "fallback": false
    },
    {
      "kind": "play_by_play",
      "lines": [
        {
          "speaker": "announcer",
          "text": "The Roman legionary closes in, shield raised high against the jungle beast.",
          "at_event": 0
        },
        {
          "speaker": "color_commentator",
          "text": "The Gorilla meets him with equal determination. Both warriors are ready.",
          "at_event": 1
        },
        {
          "speaker": "announcer",
          "text": "A solid blow from the legionary connects! The armor holds firm.",
          "at_event": 2
        },
        {
          "speaker": "color_commentator",
          "text": "But the Gorilla strikes back immediately. That bite is powerful stuff.",
          "at_event": 3
        },
        {
          "speaker": "announcer",
          "text": "Another snap from the primate! The legionary is on the defensive now.",
          "at_event": 4
        },
        {
          "speaker": "color_commentator",
          "text": "It looks like the human is struggling to find an opening.",
          "at_event": 7
        },
        {
          "speaker": "announcer",
          "text": "The Gorilla rains down bites! The Roman tries to hold the line.",
          "at_event": 10
        },
        {
          "speaker": "color_commentator",
          "text": "Those hits are relentless. The legionary’s endurance is being tested.",
          "at_event": 18
        },
        {
          "speaker": "announcer",
          "text": "The Roman attempts a counter-blow but it finds no purchase.",
          "at_event": 29
        },
        {
          "speaker": "color_commentator",
          "text": "He’s backing away. He knows he cannot withstand this onslaught.",
          "at_event": 41
        },
        {
          "speaker": "announcer",
          "text": "The legions fall! The Gorilla delivers the final, decisive strike!",
          "at_event": 60
        },
        {
          "speaker": "color_commentator",
          "text": "And that is the end. The Jungle King stands victorious once more.",
          "at_event": 61
        }
      ],
      "fallback": false
    },
    {
      "kind": "outro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Your winner: Gorilla!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "The simulation was decisive, hitting the mark 100% of the time.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "It came down to hitting power.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Want a fair fight? About 12 Roman legionaries make it a coin flip, winning 50% of the time.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Stay tuned for more carnage!",
          "at_event": null
        }
      ],
      "fallback": false
    }

      "kind": "intro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Welcome to Battle Royale! Two forces collide!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "According to legend, the Dragon enters. Mass six thousand kilograms.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "From the blue corner, a Main battle tank! Mass seventy thousand kilograms!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "A vehicle meets a beast. The simulation has decided the outcome.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Can the beast breathe fire on the steel? Let's see what happens!",
          "at_event": null
        }
      ],
      "fallback": false
    },
    {
      "kind": "play_by_play",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Dragon and tank close in for the clash!",
          "at_event": 0
        },
        {
          "speaker": "color_commentator",
          "text": "The Dragon fires first, landing a solid hit.",
          "at_event": 2
        },
        {
          "speaker": "announcer",
          "text": "Tank charges forward with a heavy ramming blow.",
          "at_event": 4
        },
        {
          "speaker": "color_commentator",
          "text": "Relentless blast fire keeps the pressure on.",
          "at_event": 37
        },
        {
          "speaker": "announcer",
          "text": "Dragon breaks contact, attempting a tactical retreat.",
          "at_event": 95
        },
        {
          "speaker": "announcer",
          "text": "The Dragon goes down! The Tank wins it!",
          "at_event": 99
        }
      ],
      "fallback": false
    },
    {
      "kind": "outro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Your winner: Main battle tank!",
          "at_event": null
        },
        {

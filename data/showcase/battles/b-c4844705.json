  "scripts": [
    {
      "kind": "intro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Ladies and gentlemen! Welcome to Battle Royale!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "A simulation has already determined the outcome.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "In the red corner, the Dragon! Weight six thousand kilograms.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "According to legend. Its size is estimated at 8.92139 meters.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "And in the blue corner, the Main battle tank! Mass seventy tons!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "It possesses more aggression than fire breath combined.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "Sheer mass decides it! Let us go to the fight!",
          "at_event": null
        }
      ],
      "fallback": false
    },
    {
      "kind": "play_by_play",
      "lines": [
        {
          "speaker": "announcer",
          "text": "The Dragon closes in, scales gleaming under the lights!",
          "at_event": 0
        },
        {
          "speaker": "color_commentator",
          "text": "The Main battle tank returns the gesture. Massive steel meets mythical scale.",
          "at_event": 1
        },
        {
          "speaker": "announcer",
          "text": "Dragon fires! A blast strikes true against the armor!",
          "at_event": 2
        },
        {
          "speaker": "announcer",
          "text": "Another hit lands! The beast is applying pressure immediately!",
          "at_event": 3
        },
        {
          "speaker": "announcer",
          "text": "Main battle tank responds with a devastating ram!",
          "at_event": 4
        },
        {
          "speaker": "color_commentator",
          "text": "Heavy machinery has heavy reach. That impact was solid.",
          "at_event": 9
        },
        {
          "speaker": "announcer",
          "text": "Dragon blasts again! Precision fire on the chassis!",
          "at_event": 12
        },
        {
          "speaker": "announcer",
          "text": "The tank rams back! No quarter given for dragons or tanks alike.",
          "at_event": 14
        },
        {
          "speaker": "color_commentator",
          "text": "Durability testing at its finest. Both combatants are holding firm.",
          "at_event": 33
        },
        {
          "speaker": "announcer",
          "text": "The Dragon breaks contact! It is retreating from the arena!",
          "at_event": 95
        },
        {
          "speaker": "announcer",
          "text": "Dragon goes down! The knockout signal is flashed!",
          "at_event": 99
        },
        {
          "speaker": "announcer",
          "text": "It is over! The Main battle tank wins by sheer mass!",
          "at_event": 100
        }
      ],
      "fallback": false
    },
    {
      "kind": "outro",
      "lines": [
        {
          "speaker": "announcer",
          "text": "Your winner: Main battle tank!",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Victory achieved 100% of the time.",
          "at_event": null
        },
        {
          "speaker": "announcer",
          "text": "It came down to sheer mass.",
          "at_event": null
        },
        {
          "speaker": "color_commentator",
          "text": "Want a fair fight? About 4 dragons make it a coin flip, winning 46% of the time.",
          "at_event": null
        }
      ],
      "fallback": false
    }
  ],
